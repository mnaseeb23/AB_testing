# WordPress & Database Environment Variables
# Copy to .env and change credentials for production

# Web Server Ports
WORDPRESS_PORT=8080
PMA_PORT=8081

# MySQL Database Settings
MYSQL_HOST=mysql
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress_secure_pass_2026
MYSQL_ROOT_PASSWORD=root_secure_pass_2026

# WordPress Configuration
WORDPRESS_DB_HOST=mysql:3306
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress_secure_pass_2026
WORDPRESS_TABLE_PREFIX=wp_

# WordPress Admin Account Setup
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=AdminPassword2026!
WP_ADMIN_EMAIL=admin@leatherjackethouse.com
WP_SITE_URL=http://localhost:8080
WP_SITE_TITLE=Leather Jacket House
WP_TAGLINE=Premium Leather Jackets for Every Style

# WooCommerce Store Settings
WC_CURRENCY=USD
WC_CURRENCY_POS=left
WC_PRICE_THOUSAND_SEP=,
WC_PRICE_DECIMAL_SEP=.
WC_PRICE_NUM_DECIMALS=2
WC_ENABLE_STRIPE=yes
WC_ENABLE_PAYPAL=yes
